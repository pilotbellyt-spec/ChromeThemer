{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChromeThemer",
  "version": "0.1.0",
  "identifier": "dev.chromethemer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ChromeThemer", "width": 600, "height": 270, "minWidth": 420, "minHeight": 270 }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Theme Chrome's Webium interface",
    "resources": { "../themes/": "themes/" },
    "macOS": { "signingIdentity": "-" },
    "linux": { "deb": { "depends": ["x11-utils"] } },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
